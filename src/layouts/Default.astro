---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
}

const { title, description, ogTitle, ogImage } = Astro.props;
const fullTitle = `${title} — Alvey Tools`;

// Resolve og:image to an absolute URL. Defaults to /logo.png at the site root
// until per-page custom OG images are added.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const resolvedOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`
  : `${siteUrl}/logo.png`;

// Canonical URL for the current page (helpful for og:url + crawlers).
const canonicalUrl = Astro.url
  ? `${siteUrl}${Astro.url.pathname.replace(/\/$/, "")}`
  : siteUrl;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1810" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={ogTitle ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Alvey Tools" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a1810'/%3E%3Ctext x='32' y='44' font-family='Inter,system-ui,sans-serif' font-size='38' font-weight='800' fill='%23e8dec5' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
