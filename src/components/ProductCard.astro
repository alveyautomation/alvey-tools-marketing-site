---
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Products with internal landing pages link to /tools/<slug>; others link
// straight to their external CTA (Gumroad / GitHub) so the card never 404s.
const href = product.hasLandingPage === false ? product.ctaHref : `${base}/${product.slug}`;
const isExternal = product.hasLandingPage === false;
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="card-tilt reveal group flex flex-col h-full p-6 rounded-2xl border border-ink-700 bg-ink-800/40 hover:bg-ink-900 hover:border-amber-400/40 transition-all"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-display text-xl text-ink-100 group-hover:text-white">
      {product.name}
    </h3>
    {product.status === "coming-soon" && (
      <span class="shrink-0 text-[10px] uppercase tracking-wider font-semibold px-2 py-1 rounded bg-ink-800 text-ink-400 border border-ink-700 font-mono">
        Soon
      </span>
    )}
  </div>

  <p class="text-sm text-ink-300 leading-relaxed flex-1">
    {product.tagline}
  </p>

  <div class="mt-5 pt-4 border-t border-ink-800/80 flex items-center justify-between">
    <span class="text-sm font-semibold text-amber-400">{product.pricing}</span>
    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-400 group-hover:text-amber-400 transition-colors">
      Learn more
      <span class="arrow-link">→</span>
    </span>
  </div>
</a>
