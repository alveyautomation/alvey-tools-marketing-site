---
// Placeholder testimonials. Real quotes are pending. To swap in a real quote
// later, replace `pending: true` with the real `quote`, `name`, and `role` and
// the "coming soon" tag will disappear automatically.
//
// Headshot placeholders are rendered as initials inside a circle. Once a real
// headshot is available, drop the image at /public/testimonials/<slug>.jpg and
// add an `image` field; the component will render <img> instead of initials.

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  initials: string;
  image?: string;
  pending?: boolean;
}

const testimonials: Testimonial[] = [
  {
    quote:
      "Once we plug Claude into our SellerCloud catalog, the morning ops cycle drops from 45 minutes to 5.",
    name: "Customer testimonial pending",
    role: "Multi-channel ecommerce ops lead, $12M/yr brand",
    initials: "MO",
    pending: true,
  },
  {
    quote:
      "The vendor-anomaly alerts paid for the year in the first month. We caught a $9k duplicate bill on day three.",
    name: "Customer testimonial pending",
    role: "Controller, distribution and fulfillment company",
    initials: "FC",
    pending: true,
  },
  {
    quote:
      "Read-only by default is the right answer. I trust Claude with the books because the MCP server literally cannot mutate them.",
    name: "Customer testimonial pending",
    role: "Founder, B2B SaaS using QuickBooks Online",
    initials: "BS",
    pending: true,
  },
];
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="mb-10 text-center">
    <div
      class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-400 mb-3"
    >
      Field Notes
    </div>
    <h2 class="font-display text-3xl sm:text-4xl text-ink-100 mb-3">
      What operators are saying
    </h2>
    <p class="text-ink-400 text-sm sm:text-base max-w-2xl mx-auto">
      Real quotes from real customers are landing as v0.1 rollouts go live.
      Placeholders below show the shape; they will be replaced as customers
      give the green light to publish.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {
      testimonials.map((t) => (
        <figure class="flex flex-col h-full p-6 rounded-xl border border-ink-800 bg-ink-900/60">
          <blockquote class="flex-1 text-ink-200 leading-relaxed text-[0.95rem] mb-6">
            <span class="text-amber-400/80 font-display text-3xl leading-none align-top mr-1">
              "
            </span>
            {t.quote}
          </blockquote>
          <figcaption class="flex items-center gap-3 pt-4 border-t border-ink-800/80">
            {t.image ? (
              <img
                src={t.image}
                alt={t.name}
                class="w-10 h-10 rounded-full object-cover border border-ink-700"
                width="40"
                height="40"
                loading="lazy"
              />
            ) : (
              <div
                class="w-10 h-10 rounded-full bg-ink-700 border border-ink-600 flex items-center justify-center text-amber-400 font-semibold text-sm"
                aria-hidden="true"
              >
                {t.initials}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <div class="text-ink-100 text-sm font-semibold truncate">
                {t.name}
              </div>
              <div class="text-ink-400 text-xs leading-snug">
                {t.role}
              </div>
            </div>
            {t.pending && (
              <span class="shrink-0 text-[10px] uppercase tracking-wider font-semibold px-2 py-1 rounded bg-ink-800 text-ink-400 border border-ink-700">
                Soon
              </span>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
