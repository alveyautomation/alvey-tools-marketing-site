---
// Zero-JS, keyboard-accessible FAQ using <details><summary>. Each item
// expands on click or Enter/Space. State is tracked by the browser, not by
// any client-side script.
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  heading?: string;
  eyebrow?: string;
  intro?: string;
}

const {
  items,
  heading = "Frequently asked",
  eyebrow,
  intro,
} = Astro.props;
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="mb-10 text-center">
    {eyebrow && (
      <div
        class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-400 mb-3"
      >
        {eyebrow}
      </div>
    )}
    <h2 class="font-display text-3xl sm:text-4xl text-ink-100 mb-3">
      {heading}
    </h2>
    {intro && (
      <p class="text-ink-400 text-sm sm:text-base max-w-2xl mx-auto">
        {intro}
      </p>
    )}
  </div>

  <div class="space-y-3">
    {
      items.map((item) => (
        <details class="faq-item group rounded-lg border border-ink-800 bg-ink-900/60 hover:border-ink-700 transition-colors">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none text-ink-100 font-semibold text-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/60 focus-visible:rounded-lg">
            <span>{item.question}</span>
            <svg
              class="w-5 h-5 shrink-0 text-amber-400 transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </summary>
          <div class="px-5 pb-5 -mt-1 text-ink-300 leading-relaxed text-[0.95rem]">
            {item.answer}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Hide the default disclosure marker across browsers so our chevron is the
     only indicator. summary::-webkit-details-marker covers Safari/Chrome and
     `list-style: none` covers Firefox. */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary {
    list-style: none;
  }
</style>
