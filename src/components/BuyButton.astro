---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  size?: "md" | "lg";
}

const { href, label, variant = "primary", size = "md" } = Astro.props;

const sizeClass =
  size === "lg" ? "px-7 py-4 text-base" : "px-5 py-3 text-sm";

const variantClass =
  variant === "primary"
    ? "gradient-amber text-ink-950 hover:brightness-95 shadow-lg shadow-amber-500/20"
    : "border border-ink-600 text-ink-100 hover:border-amber-400 hover:text-amber-400";
---

<a
  href={href}
  class={`inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-all ${sizeClass} ${variantClass}`}
>
  {label}
  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
  </svg>
</a>
