---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  heading?: string;
}

const { items, heading = "FAQ" } = Astro.props;
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h2 class="font-display text-3xl sm:text-4xl text-ink-100 mb-8">{heading}</h2>
  <dl class="space-y-6">
    {
      items.map((item) => (
        <div class="border-l-2 border-amber-400/40 pl-5">
          <dt class="font-semibold text-ink-100 text-base mb-2">
            {item.question}
          </dt>
          <dd class="text-ink-300 leading-relaxed text-[0.95rem]">
            {item.answer}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
