---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="border-b border-ink-800/80 bg-ink-950/85 backdrop-blur sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a
      href={`${base}/`}
      class="flex items-center gap-3 group"
      aria-label="Alvey Automation home"
    >
      <img
        src={`${base}/alvey-mark.png`}
        alt=""
        class="h-10 sm:h-11 w-auto transition-transform group-hover:scale-105"
        loading="eager"
      />
      <span class="font-display text-base sm:text-lg text-sand tracking-tight hidden sm:inline">
        Alvey<span class="text-ink-400 font-normal"> Tools</span>
      </span>
    </a>

    <nav class="flex items-center gap-1 text-sm" aria-label="Primary">
      <a
        href="https://alveyautomation.com/"
        class="nav-link hidden md:inline-flex px-3 py-2 font-medium text-ink-300 hover:text-white transition-colors"
      >
        Home
      </a>
      <a
        href={`${base}/`}
        class="nav-link hidden md:inline-flex px-3 py-2 font-medium text-ink-300 hover:text-white transition-colors"
      >
        Catalog
      </a>
      <a
        href="https://alveyautomation.com/websites"
        class="nav-link hidden md:inline-flex px-3 py-2 font-medium text-ink-300 hover:text-white transition-colors"
      >
        Websites
      </a>
      <a
        href="mailto:brett@alveyautomation.com"
        class="ml-1 md:ml-2 px-3 sm:px-4 py-2 rounded-md font-semibold text-ink-950 bg-amber-400 hover:bg-amber-300 transition-colors text-xs sm:text-sm"
      >
        Get in touch
      </a>
    </nav>
  </div>
</header>
