---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="border-b border-ink-800/80 bg-ink-950/90 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a
      href={`${base}/`}
      class="flex items-center group"
      aria-label="Alvey Automation home"
    >
      <img
        src={`${base}/logo.png`}
        alt="Alvey Automation"
        class="h-12 w-auto sm:h-14"
        width="56"
        height="56"
        loading="eager"
      />
    </a>

    <nav class="flex items-center gap-1 sm:gap-3" aria-label="Primary">
      <a
        href={`${base}/`}
        class="px-3 py-2 text-sm font-medium text-ink-300 hover:text-white transition-colors"
      >
        All tools
      </a>
      <a
        href="mailto:brett@alveyautomation.com"
        class="px-3 py-2 text-sm font-medium text-ink-300 hover:text-white transition-colors"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
