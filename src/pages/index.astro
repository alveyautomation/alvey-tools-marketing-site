---
import Default from "../layouts/Default.astro";
import ProductCard from "../components/ProductCard.astro";
import BuyButton from "../components/BuyButton.astro";
import {
  products,
  productsByCategory,
  categoryOrder,
  categoryDescriptions,
} from "../data/products";

const liveCount = products.filter((p) => p.status !== "coming-soon").length;
---

<Default
  title="Operational tooling for indie devs and ecommerce operators"
  description="Marketplace apps, MCP servers, and downloads from Alvey Automation. Built from running multi-million-dollar production automation."
  ogTitle="Alvey Tools"
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-b from-amber-500/10 via-transparent to-transparent pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-14 sm:pt-28 sm:pb-20 text-center"
    >
      <div
        class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400 mb-5"
      >
        Alvey Automation Tools
      </div>
      <h1
        class="font-display text-5xl sm:text-6xl lg:text-7xl text-ink-100 leading-[1.05] mb-6"
      >
        Tools that quietly catch the
        <span class="text-gradient-amber">expensive mistakes</span>.
      </h1>
      <p
        class="max-w-2xl mx-auto text-lg sm:text-xl text-ink-300 leading-relaxed mb-10"
      >
        Marketplace apps, MCP servers, and downloads built from running
        multi-million-dollar production automation. Read-only by default,
        idempotent, and the patterns that catch silent bugs before they
        compound.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <BuyButton
          href="#products"
          label="See all tools"
          size="lg"
        />
        <BuyButton
          href="mailto:brett@alveyautomation.com"
          label="Email Brett"
          variant="secondary"
          size="lg"
        />
      </div>

      <div class="terminal-preview">
        <div class="terminal-header">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">claude — qbo-mcp connected</span>
        </div>
        <div class="terminal-body">
          <div class="line"><span class="prompt">›</span><span class="user-text">How much do we owe WidgetCo right now?</span></div>
          <div class="line response"><span class="check">✓</span>Found 3 open bills against WidgetCo:</div>
          <div class="line indent">Bill #2847 — $12,400 — due 2026-05-01</div>
          <div class="line indent">Bill #2861 — $8,950 — due 2026-05-08</div>
          <div class="line indent">Bill #2884 — $3,200 — due 2026-05-15</div>
          <div class="line spacer"></div>
          <div class="line total-line">Total open: <span class="total-amount">$24,550</span> across 3 bills</div>
        </div>
      </div>
    </div>
  </section>

  <section id="products" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {
      categoryOrder.map((category) => {
        const items = productsByCategory(category);
        return (
          <div class="mb-16 last:mb-0">
            <div class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
              <div>
                <h2 class="font-display text-3xl sm:text-4xl text-ink-100 mb-2">
                  {category}
                </h2>
                <p class="text-ink-400 text-sm sm:text-base max-w-2xl">
                  {categoryDescriptions[category]}
                </p>
              </div>
              <span class="text-xs uppercase tracking-wider text-amber-400 font-semibold">
                {items.length} {items.length === 1 ? "tool" : "tools"}
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {items.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </div>
        );
      })
    }
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="font-display text-3xl sm:text-4xl text-ink-100 mb-5">
      Built from running production at scale.
    </h2>
    <p class="text-ink-300 text-lg leading-relaxed max-w-2xl mx-auto mb-8">
      Every tool here exists because its absence cost a real ecommerce
      operation real money. The patterns are the same ones running today in
      production — extracted, anonymized, and packaged so you can drop them
      into your own stack in an afternoon.
    </p>
    <BuyButton
      href="mailto:brett@alveyautomation.com?subject=Custom%20automation%20question"
      label="Talk to Brett about custom work"
      variant="secondary"
      size="lg"
    />
  </section>
</Default>
